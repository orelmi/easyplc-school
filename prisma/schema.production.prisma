// Production schema for PostgreSQL
// Copy this to schema.prisma when deploying to production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  avatar        String?
  totalXp       Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastActivity  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress      LessonProgress[]
  rewards       UserReward[]
  quizAttempts  QuizAttempt[]

  @@index([email])
  @@index([username])
}

model Cursus {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String
  color       String
  order       Int
  createdAt   DateTime @default(now())

  modules      CursusModule[]
  translations CursusTranslation[]

  @@index([order])
}

model CursusModule {
  id         String  @id @default(uuid())
  cursusId   String
  moduleId   String
  order      Int
  isRequired Boolean @default(true)

  cursus Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([cursusId, moduleId])
  @@index([cursusId])
  @@index([moduleId])
}

model CursusTranslation {
  id          String @id @default(uuid())
  cursusId    String
  language    String
  title       String
  description String
  createdAt   DateTime @default(now())

  cursus Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  @@unique([cursusId, language])
  @@index([language])
}

model Module {
  id          String    @id @default(uuid())
  title       String
  description String
  order       Int
  icon        String
  color       String
  isLocked    Boolean   @default(true)
  requiredXp  Int       @default(0)
  createdAt   DateTime  @default(now())

  lessons       Lesson[]
  translations  ModuleTranslation[]
  cursusModules CursusModule[]

  @@index([order])
}

model ModuleTranslation {
  id          String    @id @default(uuid())
  moduleId    String
  language    String
  title       String
  description String
  createdAt   DateTime  @default(now())

  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, language])
  @@index([language])
}

model Lesson {
  id          String    @id @default(uuid())
  moduleId    String
  title       String
  description String
  content     String    @db.Text
  order       Int
  xpReward    Int       @default(50)
  duration    Int       @default(10)
  createdAt   DateTime  @default(now())

  module       Module    @relation(fields: [moduleId], references: [id])
  progress     LessonProgress[]
  quizzes      Quiz[]
  translations LessonTranslation[]

  @@index([moduleId])
  @@index([order])
}

model LessonTranslation {
  id          String    @id @default(uuid())
  lessonId    String
  language    String
  title       String
  description String
  content     String    @db.Text
  createdAt   DateTime  @default(now())

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language])
  @@index([language])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  score       Int?
  timeSpent   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Quiz {
  id          String    @id @default(uuid())
  lessonId    String
  question    String    @db.Text
  options     String    @db.Text // JSON array of options
  correctIndex Int
  explanation String?   @db.Text
  order       Int
  createdAt   DateTime  @default(now())

  lesson       Lesson    @relation(fields: [lessonId], references: [id])
  attempts     QuizAttempt[]
  translations QuizTranslation[]

  @@index([lessonId])
}

model QuizTranslation {
  id          String    @id @default(uuid())
  quizId      String
  language    String
  question    String    @db.Text
  options     String    @db.Text // JSON array of translated options
  explanation String?   @db.Text
  createdAt   DateTime  @default(now())

  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, language])
  @@index([language])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  answer      Int
  isCorrect   Boolean
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  quiz        Quiz      @relation(fields: [quizId], references: [id])

  @@index([userId])
  @@index([quizId])
}

model Reward {
  id          String    @id @default(uuid())
  name        String
  description String
  icon        String
  type        String    // badge, trophy, certificate
  condition   String    // JSON condition for unlocking
  xpBonus     Int       @default(0)
  createdAt   DateTime  @default(now())

  users        UserReward[]
  translations RewardTranslation[]
}

model RewardTranslation {
  id          String    @id @default(uuid())
  rewardId    String
  language    String
  name        String
  description String
  createdAt   DateTime  @default(now())

  reward      Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, language])
  @@index([language])
}

model UserReward {
  id          String    @id @default(uuid())
  userId      String
  rewardId    String
  earnedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  reward      Reward    @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId])
  @@index([userId])
}
