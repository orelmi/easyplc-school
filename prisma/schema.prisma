generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String?   // Optional for OAuth users
  avatar        String?
  totalXp       Int       @default(0)
  level         Int       @default(1)
  streak        Int       @default(0)
  lastActivity  DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  progress         LessonProgress[]
  rewards          UserReward[]
  quizAttempts     QuizAttempt[]
  accounts         Account[]
  exerciseProgress ExerciseProgress[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String  // google, facebook, microsoft, credentials
  providerAccountId String
  accessToken       String?
  refreshToken      String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Cursus {
  id          String   @id @default(uuid())
  title       String
  description String
  icon        String
  color       String
  order       Int
  createdAt   DateTime @default(now())

  modules      CursusModule[]
  translations CursusTranslation[]
}

model CursusModule {
  id         String  @id @default(uuid())
  cursusId   String
  moduleId   String
  order      Int
  isRequired Boolean @default(true)

  cursus Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([cursusId, moduleId])
}

model CursusTranslation {
  id          String @id @default(uuid())
  cursusId    String
  language    String
  title       String
  description String
  createdAt   DateTime @default(now())

  cursus Cursus @relation(fields: [cursusId], references: [id], onDelete: Cascade)

  @@unique([cursusId, language])
}

model Module {
  id          String    @id @default(uuid())
  title       String
  description String
  order       Int
  icon        String
  color       String
  isLocked    Boolean   @default(true)
  requiredXp  Int       @default(0)
  createdAt   DateTime  @default(now())

  lessons       Lesson[]
  translations  ModuleTranslation[]
  cursusModules CursusModule[]
  exercises     Exercise[]
}

model ModuleTranslation {
  id          String    @id @default(uuid())
  moduleId    String
  language    String
  title       String
  description String
  createdAt   DateTime  @default(now())

  module      Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, language])
}

model Lesson {
  id          String    @id @default(uuid())
  moduleId    String
  title       String
  description String
  content     String
  order       Int
  xpReward    Int       @default(50)
  duration    Int       @default(10)
  createdAt   DateTime  @default(now())

  module       Module    @relation(fields: [moduleId], references: [id])
  progress     LessonProgress[]
  quizzes      Quiz[]
  translations LessonTranslation[]
}

model LessonTranslation {
  id          String    @id @default(uuid())
  lessonId    String
  language    String
  title       String
  description String
  content     String
  createdAt   DateTime  @default(now())

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, language])
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  score       Int?
  timeSpent   Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  lesson      Lesson    @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Quiz {
  id          String    @id @default(uuid())
  lessonId    String
  question    String
  options     String    // JSON array of options
  correctIndex Int
  explanation String?
  order       Int
  createdAt   DateTime  @default(now())

  lesson       Lesson    @relation(fields: [lessonId], references: [id])
  attempts     QuizAttempt[]
  translations QuizTranslation[]
}

model QuizTranslation {
  id          String    @id @default(uuid())
  quizId      String
  language    String
  question    String
  options     String    // JSON array of translated options
  explanation String?
  createdAt   DateTime  @default(now())

  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, language])
}

model QuizAttempt {
  id          String    @id @default(uuid())
  userId      String
  quizId      String
  answer      Int
  isCorrect   Boolean
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  quiz        Quiz      @relation(fields: [quizId], references: [id])
}

model Reward {
  id          String    @id @default(uuid())
  name        String
  description String
  icon        String
  type        String    // badge, trophy, certificate
  condition   String    // JSON condition for unlocking
  xpBonus     Int       @default(0)
  createdAt   DateTime  @default(now())

  users        UserReward[]
  translations RewardTranslation[]
}

model RewardTranslation {
  id          String    @id @default(uuid())
  rewardId    String
  language    String
  name        String
  description String
  createdAt   DateTime  @default(now())

  reward      Reward    @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([rewardId, language])
}

model UserReward {
  id          String    @id @default(uuid())
  userId      String
  rewardId    String
  earnedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id])
  reward      Reward    @relation(fields: [rewardId], references: [id])

  @@unique([userId, rewardId])
}

model Exercise {
  id          String    @id @default(uuid())
  moduleId    String
  title       String
  description String
  type        String    // fill_blank, ordering, matching, code_input, drag_drop, wiring, timing, ladder_builder, plc_simulator
  difficulty  String    // beginner, intermediate, advanced
  instructions String   // JSON with step-by-step instructions
  config      String?   // JSON configuration for the exercise type
  initialCode String?   // Initial code/configuration for the exercise (legacy)
  solution    String    // Expected solution (JSON)
  hints       String?   // JSON array of hints
  xpReward    Int       @default(100)
  order       Int
  createdAt   DateTime  @default(now())

  module       Module    @relation(fields: [moduleId], references: [id])
  translations ExerciseTranslation[]
  progress     ExerciseProgress[]
}

model ExerciseTranslation {
  id           String    @id @default(uuid())
  exerciseId   String
  language     String
  title        String
  description  String
  instructions String
  hints        String?
  createdAt    DateTime  @default(now())

  exercise     Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, language])
}

model ExerciseProgress {
  id          String    @id @default(uuid())
  userId      String
  exerciseId  String
  completed   Boolean   @default(false)
  attempts    Int       @default(0)
  bestScore   Int?
  userCode    String?   // User's last submitted solution
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@unique([userId, exerciseId])
}
